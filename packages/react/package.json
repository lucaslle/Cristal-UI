    "@stencil/react-output-target": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/generated/components.server.d.ts",
      "import": "./dist/generated/components.server.js"
    },
    "./tokens.css": "./dist/tokens.css"

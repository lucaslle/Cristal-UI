{
  "name": "@cristal/react",
  "version": "0.0.0",
  "description": "React and Next.js wrappers for the Cristal accessible web components, with server rendering and design tokens.",
  "keywords": [
    "react",
    "nextjs",
    "web-components",
    "design-system",
    "accessibility",
    "rgaa",
    "wcag"
  ],
  "license": "MIT",
  "author": "Lucas LALICHE",
  "homepage": "https://lucaslle.github.io/Cristal-UI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaslle/Cristal-UI.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/lucaslle/Cristal-UI/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for (const f of ['tokens.css', 'tokens-dark.css']) require('node:fs').copyFileSync('../tokens/build/' + f, 'dist/' + f)\""
  },
  "dependencies": {
    "@cristal/core": "workspace:*",
    "@stencil/react-output-target": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/generated/components.server.d.ts",
      "import": "./dist/generated/components.server.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens-dark.css": "./dist/tokens-dark.css"
  }
}

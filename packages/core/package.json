{
  "name": "@cristal/core",
  "version": "0.1.0",
  "description": "Accessible web components (RGAA, WCAG AA) with a cr- prefix, built with Stencil. Works in any framework.",
  "keywords": [
    "web-components",
    "custom-elements",
    "stencil",
    "design-system",
    "accessibility",
    "rgaa",
    "wcag"
  ],
  "license": "MIT",
  "author": "Lucas LALICHE",
  "homepage": "https://lucaslle.github.io/Cristal-UI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaslle/Cristal-UI.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/lucaslle/Cristal-UI/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "loader",
    "hydrate"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": "./loader/index.js",
    "./hydrate": "./hydrate/index.js",
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "stencil build",
    "test": "vitest run"
  },
  "dependencies": {
    "@cristal/tokens": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "@stencil/react-output-target": "^1.7.0",
    "vitest": "^5.1.0"
  },
  "collection": "dist/collection/collection-manifest.json"
}

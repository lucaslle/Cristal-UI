{
  "color": {
    "primary": {
      "$value": "#6d28d9",
      "$type": "color"
    },
    "primary-hover": {
      "$value": "color-mix(in oklab, {color.primary} 82%, oklch(from {color.primary} clamp(0, (l - 0.62) * 1000, 1) 0 0))"
    },
    "primary-text": {
      "$value": "oklch(from {color.primary} min(l, 0.47) c h)"
    },
    "primary-subtle": {
      "$value": "color-mix(in oklab, {color.primary} 12%, white)"
    },
    "primary-subtle-hover": {
      "$value": "color-mix(in oklab, {color.primary} 18%, white)"
    },
    "on-primary": {
      "$value": "oklch(from {color.primary} clamp(0, (0.62 - l) * 1000, 1) 0 0)"
    },
    "primary-indicator": {
      "$value": "{color.primary}"
    },
    "focus": {
      "$value": "{color.primary-text}"
    },
    "text": {
      "$value": "#111827",
      "$type": "color"
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "disabled": {
      "$value": "#e5e7eb",
      "$type": "color"
    },
    "on-disabled": {
      "$value": "#6b7280",
      "$type": "color"
    },
    "danger": {
      "$value": "#b91c1c",
      "$type": "color"
    },
    "success": {
      "$value": "#15803d",
      "$type": "color"
    },
    "border": {
      "$value": "#6b7280",
      "$type": "color"
    },
    "text-muted": {
      "$value": "#4b5563",
      "$type": "color"
    },
    "overlay": {
      "$value": "rgba(17, 24, 39, 0.5)",
      "$type": "color"
    },
    "chart-1": {
      "$value": "#6d28d9",
      "$type": "color"
    },
    "chart-2": {
      "$value": "#eb6834",
      "$type": "color"
    },
    "chart-3": {
      "$value": "#1baf7a",
      "$type": "color"
    },
    "chart-4": {
      "$value": "#eda100",
      "$type": "color"
    },
    "chart-5": {
      "$value": "#e87ba4",
      "$type": "color"
    },
    "chart-6": {
      "$value": "#008300",
      "$type": "color"
    },
    "chart-7": {
      "$value": "#2a78d6",
      "$type": "color"
    },
    "chart-8": {
      "$value": "#e34948",
      "$type": "color"
    }
  }
}
